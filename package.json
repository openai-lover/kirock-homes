{
  "name": "room-of-suspects",
  "version": "1.0.0",
  "private": true,
  "engines": {
    "node": "24.x"
  },
  "scripts": {
    "dev": "next dev --hostname 127.0.0.1",
    "build": "next build",
    "start": "next start --hostname 127.0.0.1",
    "typecheck": "next typegen && tsc --noEmit",
    "test": "node --import tsx --conditions=react-server --test tests/*.test.ts",
    "test:e2e": "playwright test",
    "cleanup": "node --env-file-if-exists=.env.local --import tsx --conditions=react-server scripts/cleanup.ts",
    "package": "node scripts/package.mjs"
  },
  "dependencies": {
    "@libsql/client": "0.18.0",
    "next": "16.4.3",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "server-only": "0.0.1",
    "sharp": "0.35.5"
  },
  "devDependencies": {
    "@playwright/test": "1.64.1",
    "@types/node": "^24.0.0",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "tsx": "4.23.15",
    "typescript": "5.9.3"
  }
}
