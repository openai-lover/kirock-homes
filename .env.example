# No external account or API key is required for the sample, uploads, manual
# casting, or local sharing. Copy this file to .env.local only when needed.
# Never prefix secrets with NEXT_PUBLIC_. Never commit .env.local or .data/.

# LOCAL SQLITE ADAPTER: a single Node.js host with a persistent, writable disk.
# This is not a distributed database or ephemeral/serverless deployment adapter.
# Use a private path, outside public/. Relative paths resolve from project root.
SHARE_DB_PATH=.data/room-of-suspects.sqlite

# Optional canonical browser origin for a reverse proxy. Exact scheme + host +
# optional port; e.g. https://your-host.example. Also selects Secure cookies.
# Leave blank for local development. Host publicly only after configuring HTTPS.
APP_ORIGIN=

# Optional vision adapter, disabled by default. Set all four values to enable.
# Choose a provider/model that actually supports Chat Completions vision inputs
# and JSON object output; verify access, price and retention policy yourself.
# AI_BASE_URL is an HTTPS API prefix (e.g. https://api.openai.com/v1), not a
# user-controlled URL. No model/account access is assumed or tested live.
AI_PROVIDER=
AI_BASE_URL=
AI_MODEL=
AI_API_KEY=

# Persistent request caps (integer 0..10000). Zero disables chargeable calls.
# Counts attempted provider requests, including failures; NOT a currency budget.
# Also at most two attempts per identical normalized image within 15 minutes.
# UTC day boundary. Total counter survives restart and has no automatic reset.
AI_DAILY_LIMIT=20
AI_TOTAL_LIMIT=100

# Retention: links expire after seven days; SQLite rows, image BLOBs and plays
# are removed on server startup and hourly while running. For continuous
# deletion guarantees when the app is stopped, schedule `npm run cleanup`
# at least hourly under the same environment and monitor its JSON status logs.
# No host, scheduler, provider account or public deployment has been provisioned.

# Optional runtime group-chat interpretation. With no configuration, authored
# local replies still finish the game. AI never receives photos or solutions.
CHAT_PROVIDER=
# Local developer Kiro adapter: verified with Kiro CLI 2.37.0, engine v2.
# Use your existing signed-in session. These paths are operator-specific.
# Do not copy another person's credentials or ship the authenticated home.
KIRO_CLI_PATH=
KIRO_HOME=
CHAT_KIRO_WORKDIR=.data/chat-runtime
# For a hosted game, use a separately provisioned HTTPS-compatible provider.
CHAT_BASE_URL=
CHAT_MODEL=
CHAT_API_KEY=
CHAT_DB_PATH=.data/chat.sqlite
# Attempt counts, NOT credit or currency guarantees. 24 requests per case/hour.
CHAT_DAILY_LIMIT=40
CHAT_TOTAL_LIMIT=200
# Kiro runtime calls may consume the signed-in account's available allowance.
# Contest credit approval/redemption is not verified by this app.
